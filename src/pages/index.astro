---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mermaid from "../components/Mermaid";
import { CORE_MODULES } from "../data/modules";

const title = "首页";
const description = "Mastra AI Agent 框架核心架构总览 — 模块关系图与高层导览";
const currentPath = "/";

const architectureChart = `flowchart TD
    Mastra["mastra/\\n(DI Container)"]
    Agent["agent/\\n(AI Agent)"]
    Loop["loop/\\n(Agentic Loop)"]
    Workflows["workflows/\\n(DAG Engine)"]
    LLM["llm/\\n(Model Layer)"]
    Processors["processors/\\n(Middleware Pipeline)"]
    Tools["tools/\\n(Tool System)"]
    Storage["storage/\\n(Persistence)"]
    Memory["memory/\\n(Conversation State)"]
    Stream["stream/\\n(Output Streaming)"]
    Events["events/\\n(PubSub)"]
    Observability["observability/\\n(Tracing)"]

    Mastra --> Agent
    Mastra --> Workflows
    Mastra --> LLM
    Mastra --> Tools
    Mastra --> Storage
    Mastra --> Memory
    Mastra --> Events
    Mastra --> Observability

    Agent --> LLM
    Agent --> Loop
    Agent --> Processors
    Agent --> Memory
    Agent --> Tools
    Agent --> Workflows
    Agent --> Stream
    Agent --> Storage
    Agent --> Events

    Loop --> Workflows
    Loop --> Stream
    Loop --> Processors
    Loop --> Observability

    LLM --> Loop
    LLM --> Stream
    LLM --> Observability

    Processors --> Memory
    Processors --> LLM
    Processors --> Workflows

    Workflows --> Storage
    Workflows --> Events
    Workflows --> Observability

    Memory --> Storage
    Memory --> Processors

    classDef core fill:#eef2ff,stroke:#6366f1,color:#312e81,stroke-width:1.5px,rx:8;
    classDef secondary fill:#f9fafb,stroke:#d1d5db,color:#4b5563,stroke-width:1px,rx:8;
    class Mastra,Agent,Loop,Workflows,LLM,Processors,Tools,Storage core;
    class Memory,Stream,Events,Observability secondary;`;

const nodeLinks: Record<string, string> = {
  "mastra/": "module-mastra",
  "agent/": "module-agent",
  "loop/": "module-loop",
  "workflows/": "module-workflows",
  "llm/": "module-llm",
  "processors/": "module-processors",
  "tools/": "module-tools",
  "storage/": "module-storage",
};
---

<BaseLayout title={title} description={description} currentPath={currentPath}>
  <!-- Hero -->
  <section class="relative pt-4 pb-12">
    <div class="flex items-center gap-2 mb-5">
      <span class="eyebrow">packages/core/src</span>
      <span class="text-subtle">·</span>
      <a href="https://github.com/mastra-ai/mastra" target="_blank" rel="noopener" class="text-[11px] font-mono text-muted hover:text-[var(--color-fg)] transition-colors">mastra-ai/mastra ↗</a>
    </div>

    <h1 class="text-[2.6rem] lg:text-[3.4rem] font-bold leading-[1.05] mb-5 max-w-4xl">
      <span class="block">Mastra 源码</span>
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#111827] via-[#4338ca] to-[#6366f1]">
        架构地图
      </span>
    </h1>

    <p class="text-base lg:text-[17px] text-muted max-w-2xl leading-[1.65] mb-7 font-[350]">
      TypeScript AI Agent 框架——用声明式配置构建拥有工具、记忆、可观测性与 <span class="font-mono text-[var(--color-primary)]">durable execution</span> 能力的 Agent。
      底层把 agentic 循环建模为可中断恢复的 Workflow。这份地图帮你在读源码时<span class="text-fg">定位模块、看见依赖、读懂取舍</span>。
    </p>

    <!-- Meta strip -->
    <div class="flex items-center gap-x-5 gap-y-2 flex-wrap text-[12px] font-mono">
      <div class="flex items-baseline gap-1.5">
        <span class="text-fg tabular-nums text-base font-semibold">56</span>
        <span class="text-subtle">top-level modules</span>
      </div>
      <div class="w-px h-3 bg-[var(--color-border)]"></div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-[var(--color-primary)] tabular-nums text-base font-semibold">8</span>
        <span class="text-subtle">core</span>
      </div>
      <div class="w-px h-3 bg-[var(--color-border)]"></div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-fg-muted tabular-nums text-base font-semibold">48</span>
        <span class="text-subtle">secondary</span>
      </div>
      <div class="w-px h-3 bg-[var(--color-border)]"></div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-fg-muted tabular-nums text-base font-semibold">~160k</span>
        <span class="text-subtle">lines of TypeScript</span>
      </div>
    </div>
  </section>

  <!-- Architecture Diagram -->
  <section class="mt-4 mb-16">
    <div class="flex items-baseline justify-between mb-3.5">
      <h2 class="text-lg font-semibold tracking-tight">模块依赖关系</h2>
      <span class="text-[11px] text-subtle font-mono">点击节点跳转 →</span>
    </div>
    <div class="mermaid-wrap p-5 lg:p-7">
      <Mermaid client:load chart={architectureChart} nodeLinks={nodeLinks} />
    </div>
    <div class="flex items-center gap-5 mt-3 text-[11.5px] text-muted">
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-sm border border-[var(--color-primary)] bg-[#eef2ff] inline-block"></span>
        Core module (8)
      </span>
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-sm border border-[#d1d5db] bg-[#f9fafb] inline-block"></span>
        Secondary module
      </span>
      <span class="hidden sm:inline text-subtle">箭头方向: A → B 表示 A 依赖 B</span>
    </div>
  </section>

  <!-- Core Modules Overview -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-lg font-semibold tracking-tight">Core Modules</h2>
      <a href="/modules" class="text-[13px] text-[var(--color-primary)] hover:text-[var(--color-primary-strong)] transition-colors font-medium flex items-center gap-1 group">
        完整模块详解
        <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      {CORE_MODULES.map((m) => (
        <a
          href={`/modules#module-${m.id}`}
          class="card card-glow p-5 pl-6 block group relative overflow-hidden"
        >
          {/* Left accent bar — animates in on hover */}
          <span
            aria-hidden="true"
            class="absolute left-0 top-2 bottom-2 w-[3px] rounded-r-full bg-gradient-to-b from-[#a5b4fc] via-[var(--color-primary)] to-[#4f46e5] scale-y-0 group-hover:scale-y-100 origin-center transition-transform duration-220"
            style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
          ></span>
          {/* Ambient wash */}
          <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-[var(--color-primary)]/5 group-hover:bg-[var(--color-primary)]/10 blur-2xl transition-colors"></div>
          <div class="relative">
            <div class="flex items-center gap-2.5 mb-2.5">
              <span class="font-mono font-semibold text-[var(--color-primary)] text-[15px] tracking-tight group-hover:text-[var(--color-primary-strong)] transition-colors">
                {m.name}/
              </span>
              <span class="chip">{m.totalLoc.toLocaleString()} LoC</span>
            </div>
            <p class="text-sm text-muted leading-[1.6] group-hover:text-[color:var(--color-fg)]/80 transition-colors line-clamp-3">
              {m.role}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Pathways -->
  <section class="mb-10 grid sm:grid-cols-2 gap-3">
    <a href="/dataflow" class="card card-hover p-5 lg:p-6 group">
      <div class="flex items-center justify-between mb-2">
        <div class="text-[15px] font-semibold tracking-tight flex items-center gap-2">
          <span class="font-mono text-[var(--color-primary)] text-xs">03</span>
          <span>agent.generate() 全链路</span>
        </div>
        <span class="text-subtle group-hover:text-[var(--color-fg)] group-hover:translate-x-0.5 transition-all">→</span>
      </div>
      <p class="text-[13.5px] text-muted leading-[1.65]">
        从用户调用到拿到结果之间，3 层嵌套 Workflow、Processor 管线、agentic 迭代循环的逐步骤拆解。
      </p>
    </a>
    <a href="/decisions" class="card card-hover p-5 lg:p-6 group">
      <div class="flex items-center justify-between mb-2">
        <div class="text-[15px] font-semibold tracking-tight flex items-center gap-2">
          <span class="font-mono text-[var(--color-primary)] text-xs">04</span>
          <span>5 个关键设计决策</span>
        </div>
        <span class="text-subtle group-hover:text-[var(--color-fg)] group-hover:translate-x-0.5 transition-all">→</span>
      </div>
      <p class="text-[13.5px] text-muted leading-[1.65]">
        为什么 agentic loop 是 Workflow？为什么 model 用字符串？为什么 Storage 是 22 个接口？读源码才看得见的 trade-off。
      </p>
    </a>
  </section>

  <footer class="pt-8 mt-8 border-t border-[var(--color-border)] text-[11.5px] text-subtle flex items-center justify-between flex-wrap gap-3">
    <span class="font-mono">数据基于 mastra-ai/mastra packages/core/src/ 源码扫描</span>
    <a href="https://github.com/mastra-ai/mastra" target="_blank" rel="noopener" class="link font-mono">
      github.com/mastra-ai/mastra ↗
    </a>
  </footer>
</BaseLayout>
