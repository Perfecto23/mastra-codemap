---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DECISIONS } from "../data/decisions";

const title = "设计决策";
const description = "Mastra 源码中 5 个关键架构取舍：选了什么、放弃了什么、代价是什么";
const currentPath = "/decisions";
---

<BaseLayout title={title} description={description} currentPath={currentPath}>
  <header class="mb-10">
    <div class="eyebrow mb-3">04 · trade-offs</div>
    <h1 class="text-3xl lg:text-[2.6rem] font-bold tracking-tight mb-4 leading-[1.1]">设计决策</h1>
    <p class="text-muted max-w-2xl leading-[1.7] text-[15px] font-[350]">
      读源码才能看清的 trade-off。每条决策记录三个字段：<span class="text-success">选择了什么</span>、放弃了什么、<span class="text-warn">付出什么代价</span>。
      理解了这些，代码里那些看似过度抽象的层就有了原因。
    </p>
  </header>

  <div class="space-y-5">
    {DECISIONS.map((d, i) => (
      <article id={d.id} class="card p-5 lg:p-7 scroll-mt-6 card-hover">
        <div class="flex items-start gap-4 mb-5">
          <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-primary-soft)] border border-[var(--color-border-primary)] flex items-center justify-center text-[13px] font-mono font-semibold text-[var(--color-primary)] step-index">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="flex-1 min-w-0">
            <h2 class="text-[17px] font-semibold leading-snug tracking-tight mb-2">{d.title}</h2>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[11px] text-subtle font-mono uppercase tracking-[0.1em] mr-1">affects</span>
              {d.affects.map((a) => (
                <a
                  href={`/modules#module-${a}`}
                  class="chip hover:border-[var(--color-primary)]/50"
                >
                  {a}/
                </a>
              ))}
            </div>
          </div>
        </div>

        <p class="text-[13.5px] text-muted leading-[1.75] mb-6 pl-14 pr-1 font-[350] italic border-l border-[var(--color-border)] ml-[19px] pl-5">
          "{d.context}"
        </p>

        <div class="grid md:grid-cols-3 gap-3 pl-0 md:pl-14">
          <div class="rounded-lg p-4 lg:p-4.5 bg-emerald-50 border border-emerald-200">
            <div class="text-[10.5px] font-semibold uppercase tracking-[0.12em] text-emerald-600 mb-2.5 flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-emerald-600"></span>
              选择了
            </div>
            <p class="text-[13px] text-[#1f2937] leading-[1.7] font-[350]">
              {d.chose}
            </p>
          </div>
          <div class="rounded-lg p-4 lg:p-4.5 bg-gray-50 border border-gray-200">
            <div class="text-[10.5px] font-semibold uppercase tracking-[0.12em] text-gray-500 mb-2.5 flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-gray-400"></span>
              放弃了
            </div>
            <p class="text-[13px] text-[#374151] leading-[1.7] font-[350]">
              {d.rejected}
            </p>
          </div>
          <div class="rounded-lg p-4 lg:p-4.5 bg-amber-50 border border-amber-200">
            <div class="text-[10.5px] font-semibold uppercase tracking-[0.12em] text-amber-700 mb-2.5 flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-amber-500"></span>
              代价
            </div>
            <p class="text-[13px] text-[#1f2937] leading-[1.7] font-[350]">
              {d.cost}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>

  <footer class="mt-14 pt-6 border-t border-[var(--color-border)] text-[11.5px] text-subtle leading-relaxed">
    这些决策基于 mastra-ai/mastra packages/core/src/ 当前实现推断，不是官方 ADR。源码持续演进，刷新时请以最新代码为准。
  </footer>
</BaseLayout>
